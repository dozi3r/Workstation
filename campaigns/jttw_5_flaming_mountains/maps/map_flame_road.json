    {
      "id": "N_FLAMING_MOUNTAIN",
      "name": "The Mountain of Flames",
      "x": 760,
      "y": 440,
      "cat": "Hazard",
      "tier": 3,
      "factionId": "fac_flame_households",
      "faction": "fac_flame_households",
      "culture": "Hierarchy",
      "customNotes": "**Scale:** Over 800 li of flame; no blade of grass for miles around; a bronze skull and an iron body would melt. **Origin:** The local spirit says it is the scattered bricks from Laozi's eight-trigram brazier, kicked over when Wukong escaped it 500 years ago. **Effect of the fake fan:** Fire grows brighter, then a hundredfold, then ten thousand feet tall. **Permanent fix:** 49 waves of the true fan; rain falls only where it burned. **Who is here:** The banished local spirit, formerly a Daoist furnace attendant of the Tushita Palace, with his ghost soldiers.",
      "adj": [
        "N_FLAME_LINE_CAMP",
        "N_HOARD_THUNDER"
      ],
      "childMapId": null,
      "displayName": "The Mountain of Flames",
      "coordinates": {
