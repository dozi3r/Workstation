    {
      "id": "N_RED_BRICK_VILLAGE",
      "name": "The Red-Brick Village",
      "x": 300,
      "y": 500,
      "cat": "Bastion",
      "tier": 3,
      "factionId": "fac_flame_households",
      "faction": "fac_flame_households",
      "culture": "Clan",
      "customNotes": "**Sights:** Every roof is red tile, every wall red brick, every door red paint, every bench red lacquer. **Heat:** There is no spring or autumn here; all four seasons are hot. **Who is here:** An old householder in a not-quite-yellow robe of brass cloth who offers tea and a meal, and a young man pushing a red cart who sells rice-puddings too hot to hold. **Hidden:** The householder knows the fan is not free: families offer four hogs, four sheep, flowers, fruit, fowl and wine once every ten years, after ritual baths, and walk a month to Jade Cloud Mountain. **Sociology:** S+3 / E-3 / C-1: close kin-work, subsistence farming, no resident ruler.",
      "odv": {
        "s": 3,
        "e": -2,
        "c": -1
      },
