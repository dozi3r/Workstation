{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdventureCAD Modular Loot Schemas v1",
  "version": "1.0.0",
  "contractVersion": "loot-host-v1",
  "definitions": {
    "SourcePack": {
      "type": "object",
      "required": ["schemaVersion", "sourceId", "version", "name", "edition", "provenance", "completeness", "settingDefinitions", "itemDefinitions", "tables"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "sourceId": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
        "version": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "completeness": { "type": "string", "enum": ["starter_representative", "curated_subset", "complete"] },
        "approximationNote": { "type": "string" },
        "settingDefinitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/SettingDefinition" }
        },
        "itemDefinitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/ItemDefinition" }
        },
        "tables": {
          "type": "array",
          "items": { "$ref": "#/definitions/LootTable" }
        }
      }
    },
    "SettingDefinition": {
      "type": "object",
      "required": ["key", "label", "type", "default"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-zA-Z0-9_]+$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["integer", "boolean", "enum"] },
        "default": {},
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "options": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    },
    "ItemDefinition": {
      "type": "object",
      "required": ["id", "name", "category", "description", "specs", "provenance", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "specs": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "originalValues": { "type": "object" },
        "missingFields": { "type": "array", "items": { "type": "string" } },
        "hostRef": {
          "type": ["object", "null"],
          "properties": {
            "scope": { "type": "string", "enum": ["prototype", "active_item"] },
            "id": { "type": "string" }
          }
        }
      }
    },
    "LootTable": {
      "type": "object",
      "required": ["id", "name", "entries"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/definitions/TableEntry" }
        }
      }
    },
    "TableEntry": {
      "type": "object",
      "required": ["entryId", "definitionId", "weight", "minQty", "maxQty"],
      "properties": {
        "entryId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "definitionId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "minQty": { "type": "integer", "minimum": 1 },
        "maxQty": { "type": "integer", "minimum": 1 },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["settingKey", "op", "value"],
            "properties": {
              "settingKey": { "type": "string" },
              "op": { "type": "string", "enum": ["eq", "neq", "gte", "lte", "in"] },
              "value": {}
            }
          }
        },
        "weightModifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["settingKey", "op", "value", "multiplier"],
            "properties": {
              "settingKey": { "type": "string" },
              "op": { "type": "string", "enum": ["eq", "neq", "gte", "lte", "in"] },
              "value": {},
              "multiplier": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
